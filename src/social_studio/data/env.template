# social-studio secrets (mode 0600, never commit). Only the selected backend's key enters a session.
# CLAUDE_CODE_OAUTH_TOKEN=        # `claude setup-token`, for backend.claude.auth = "token"
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# XAI_API_KEY=
# DEEPSEEK_API_KEY=
# GEMINI_API_KEY=
# OPENROUTER_API_KEY=
# Posting through Buffer: `social-studio channel connect buffer` and `... connect media` fill these.
# BUFFER_API_KEY=                 # publish.buffer.com/settings/api (personal key)
# MEDIA_ACCESS_KEY_ID=            # S3-compatible bucket Buffer fetches the video from
# MEDIA_SECRET_ACCESS_KEY=
# MCP servers in mcp.toml read only the variables their entry lists under `secrets`.
